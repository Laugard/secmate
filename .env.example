# Kopiér til .env. Indsæt aldrig et rigtigt token i denne eksempel-fil.
DISCORD_TOKEN=
DISCORD_TEST_GUILD_ID=

# Kanaler til automatiske opslag. Tom værdi deaktiverer den pågældende destination.
DISCORD_DIGEST_CHANNEL_ID=
DISCORD_NEWS_VULNERABILITIES_CHANNEL_ID=
DISCORD_NEWS_ATTACKS_CHANNEL_ID=
DISCORD_NEWS_AI_SECURITY_CHANNEL_ID=
DISCORD_NEWS_LAW_CHANNEL_ID=
DISCORD_NEWS_OTHER_CHANNEL_ID=

# Valgfri rolle. Hvis tom bruges Discord-tilladelsen Manage Guild til admin-kommandoer.
DISCORD_ADMIN_ROLE_ID=

# Lokal AI. Behold loopback-adressen; eksponér ikke Ollama på netværket.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=embeddinggemma
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

# Runtime
APP_TIMEZONE=Europe/Copenhagen
DAILY_DIGEST_TIME=09:00
DAILY_NEWS_TIME=09:15
DATABASE_PATH=data/secmate.db
DOCUMENTS_PATH=data/documents
BACKUP_PATH=data/backups
LOG_PATH=logs/secmate.log
LOG_LEVEL=INFO

# Dataminimering og grænser
MEMORY_RETENTION_DAYS=90
COMPLETED_DEADLINE_RETENTION_DAYS=30
NEWS_RETENTION_DAYS=30
LOG_RETENTION_DAYS=14
MAX_PROMPT_CHARS=1500
MAX_MEMORY_CHARS=500
MAX_DOCUMENT_MB=20
MAX_DOCUMENT_PAGES=200
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=180
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.30

# Komma-separerede, faste feeds. Brugere må ikke tilføje URL'er via Discord.
NEWS_FEED_URLS=https://www.cisa.gov/cybersecurity-advisories/all.xml
NEWS_MAX_ITEMS_PER_RUN=5
NEWS_HTTP_TIMEOUT_SECONDS=15
NEWS_MAX_RESPONSE_BYTES=2000000

